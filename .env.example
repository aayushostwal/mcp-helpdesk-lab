# Copy to .env and adjust. Every variable is optional; the defaults run the API on SQLite.
# Full reference: docs/operations.md

# Database. SQLite (default) or PostgreSQL. DATABASE_URL (no prefix) is also accepted.
HELPDESK_DATABASE_URL=sqlite+aiosqlite:///./helpdesk.db
# HELPDESK_DATABASE_URL=postgresql+asyncpg://helpdesk:helpdesk@localhost:5432/helpdesk

HELPDESK_ENVIRONMENT=dev
HELPDESK_LOG_LEVEL=INFO
HELPDESK_LOG_JSON=true
HELPDESK_HOST=127.0.0.1
HELPDESK_PORT=8000

# Pin the service clock so seeded data stays inside the refund/reopen windows.
# Use the as_of printed by `helpdesk seed`. Leave unset in production.
# HELPDESK_FROZEN_TIME=2026-06-01T12:00:00+00:00

# Business rule defaults (admins can override them at runtime via /v1/admin/settings).
HELPDESK_REFUND_WINDOW_DAYS=30
HELPDESK_REFUND_APPROVAL_THRESHOLD=500.00
HELPDESK_REOPEN_WINDOW_DAYS=7

# Webhooks: "live" sends real HTTP requests, "simulated" never leaves the process.
HELPDESK_WEBHOOK_DELIVERY=live
HELPDESK_WEBHOOK_TIMEOUT_SECONDS=5
HELPDESK_WEBHOOK_ALLOW_PRIVATE_HOSTS=false

HELPDESK_IDEMPOTENCY_TTL_HOURS=24
HELPDESK_PROBLEM_BASE_URI=https://helpdesk.example/problems/
